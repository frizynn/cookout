{
  "name": "cookout-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm lint:boundaries && pnpm test",
    "typecheck": "tsc --build",
    "lint": "eslint --max-warnings 0 .",
    "lint:boundaries": "depcruise packages",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "dependency-cruiser": "^18.8.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8",
    "vitest": "^5.1.1"
  }
}
