{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "app/main.ts!",
        "app/dev.ts!",
        "app/modules/sdk/index.ts!",
        "app/web.tsx!",
        "app/modules/testing/server.ts!",
        "app/modules/testing/web.ts!",
        "app/modules/webhook-fake/server.ts!",
        "scripts/*.{ts,mjs}!"
      ],
      "project": ["app/**/*.{ts,tsx}!", "!app/modules/*/tests/**!", "scripts/**/*.{ts,mjs}!"],
      "ignoreDependencies": ["@swc/core"]
    },
    "packages/e2e": {
      "entry": ["app/modules/*/server.ts!"],
      "project": ["app/**/*.ts!"]
    }
  }
}
